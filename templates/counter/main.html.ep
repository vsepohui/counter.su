% layout 'counter';
% title 'Counter.su';


Counter code:<br/>
<br/>
<textarea cols="80" rows="5"><%== html_escape include 'include/code' %></textarea>



<br/><br/>
%== include 'include/code';

<br/><br/>

Top-100:

<ul>
% my $i = 0;
% for (@$top) {
	<li><a href="https://<%= $_ %>"><%= $_ %></a>, <%= $stat->{$_}->{hosts} %>, <%= $stat->{$_}->{hits} %></li>
	% last if ++$i >= 100;
% }
</ul>

<br/>
Counter by <a href="https://trunaev.ru">Ivan Trunaev</a>.
